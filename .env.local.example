# Copy to .env.local and add a key for each provider your agents use, then restart the server.
# The provider for each agent is set on the Prompts page (stored in agents/<agent>/config.json).

# Claude (Anthropic). Alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Gemini (Google AI Studio). GOOGLE_API_KEY also works.
GEMINI_API_KEY=

# Optional: read the company list live from the Google Sheet. Publish the first tab as CSV
# (File → Share → Publish to web → CSV) and paste the link here. Without it the app uses
# reference/companies.csv, a copy of the sheet.
COMPANY_SHEET_CSV_URL=
